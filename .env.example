# ==============================================================================
# VoiceEnterprise - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# LLM Providers (for Generation and LLM-as-a-Judge Evaluation)
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"

# Hugging Face (for downloading benchmark models and datasets)
HF_TOKEN="your-huggingface-token-here"

# Vector Database (Qdrant)
# Defaults to local embedded storage if left empty
QDRANT_URL=""
QDRANT_API_KEY=""

# Embedding Hardware Acceleration
# Options: "mps" (Apple Silicon), "cuda" (NVIDIA GPU), "cpu"
EMBEDDING_DEVICE="mps"
EMBEDDING_BATCH_SIZE=256

# Voice AI Configuration (Speech-to-Text & Text-to-Speech)
DEEPGRAM_API_KEY="your-deepgram-api-key-here"
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
WHISPER_MODEL="whisper-1"

# Retrieval & Evaluation Hyperparameters
DEFAULT_TOP_K=20
BENCHMARK_COLLECTION_NAME="enterprise_rag_dev_10k"
